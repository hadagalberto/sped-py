{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mobbin": {
      "enabled": false
    },
    "twilio-docs": {
      "enabled": false
    },
    "cloudflare": {
      "enabled": false
    },
    "catalogo": {
      "enabled": false
    },
    "serpapi": {
      "enabled": false
    },
    "hasdata": {
      "enabled": false
    },
    "lura": {
      "enabled": false
    },
    "beavertech": {
      "enabled": false
    },
    "playwright": {
      "enabled": false
    },
    "n8n-mcp": {
      "enabled": false
    },
    "sentry": {
      "enabled": false
    },
    "fl-studio": {
      "enabled": false
    },
    "rea": {
      "enabled": false
    },
    "gsd": {
      "enabled": false
    },
    "twilio": {
      "enabled": false
    }
  },
  "tools": {
    "mobbin_*": false,
    "twilio-docs_*": false,
    "cloudflare_*": false,
    "catalogo_*": false,
    "serpapi_*": false,
    "hasdata_*": false,
    "lura_*": false,
    "beavertech_*": false,
    "playwright_*": false,
    "n8n-mcp_*": false,
    "sentry_*": false,
    "fl-studio_*": false,
    "rea_*": false,
    "gsd_*": false,
    "twilio_*": false
  },
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "gh *": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "yarn publish*": "deny",
      "dotnet nuget push*": "deny",
      "nuget push*": "deny",
      "cargo publish*": "deny",
      "twine *": "deny",
      "curl *": "ask",
      "Invoke-WebRequest*": "ask"
    }
  }
}